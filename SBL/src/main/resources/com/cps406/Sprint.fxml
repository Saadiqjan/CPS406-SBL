<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.cps406.controllers.SprintController">
   <children>
      <VBox prefHeight="600.0" prefWidth="800.0">
         <children>
            <HBox prefHeight="575.0" prefWidth="800.0">
               <children>
                  <VBox prefHeight="549.0" prefWidth="519.0">
                     <children>
                        <Label text="Sprint Backlog" />
                        <TableView fx:id="sprintTable" prefHeight="562.0" prefWidth="516.0" stylesheets="@styles.css">
                          <columns>
                              <TableColumn fx:id="completeCol" prefWidth="35.0" text="Done" />
                            <TableColumn fx:id="nameCol" prefWidth="107.0" text="Requirement" />
                              <TableColumn fx:id="priorityCol" prefWidth="75.0" text="Priority" />
                              <TableColumn fx:id="effortCol" prefWidth="75.0" text="Effort" />
                              <TableColumn fx:id="timeCol" prefWidth="75.0" text="Time Estimate" />
                              <TableColumn fx:id="riskCol" prefWidth="75.0" text="Risk" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
                  <VBox prefHeight="562.0" prefWidth="283.0">
                     <children>
                        <Label fx:id="nameLabel" layoutX="10.0" layoutY="13.0" text="Requirement:" textAlignment="CENTER">
                           <padding>
                              <Insets left="5.0" top="7.0" />
                           </padding></Label>
                        <Separator layoutX="10.0" layoutY="45.0" prefHeight="20.0" prefWidth="282.0" />
                        <Label text="Story:" textAlignment="CENTER">
                           <padding>
                              <Insets bottom="3.0" left="5.0" />
                           </padding></Label>
                        <ScrollPane fitToWidth="true" prefHeight="77.0" prefWidth="282.0">
                           <content>
                              <Label fx:id="storyLabel" />
                           </content>
                        </ScrollPane>
                        <Label text="Task:">
                           <padding>
                              <Insets bottom="3.0" left="5.0" top="5.0" />
                           </padding></Label>
                        <ScrollPane fitToWidth="true" prefHeight="82.0" prefWidth="300.0">
                           <content>
                              <Label fx:id="sprintTaskLabel" />
                           </content>
                        </ScrollPane>
                        <Label fx:id="priorityLabel" prefHeight="18.0" prefWidth="96.0" text="Priority: " textAlignment="CENTER">
                           <padding>
                              <Insets left="5.0" top="5.0" />
                           </padding></Label>
                        <Label fx:id="effortLabel" prefHeight="18.0" prefWidth="103.0" text="Effort: " textAlignment="CENTER">
                           <padding>
                              <Insets left="5.0" top="2.0" />
                           </padding></Label>
                        <Label fx:id="timeLabel" text="TIme: ">
                           <padding>
                              <Insets left="5.0" top="2.0" />
                           </padding></Label>
                        <Label fx:id="riskLabel" prefHeight="18.0" prefWidth="104.0" text="Risk: " textAlignment="CENTER">
                           <padding>
                              <Insets left="5.0" top="2.0" />
                           </padding></Label>
                        <Separator prefHeight="17.0" prefWidth="282.0" />
                        <Label text="Engineering Task:s">
                           <padding>
                              <Insets bottom="3.0" left="5.0" />
                           </padding></Label>
                        <TableView fx:id="taskTable" prefHeight="161.0" prefWidth="282.0">
                          <columns>
                            <TableColumn fx:id="taskDoneCol" prefWidth="75.0" text="Done" />
                              <TableColumn fx:id="taskDescCol" prefWidth="204.80004119873047" text="Description" />
                          </columns>
                        </TableView>
                        <Button mnemonicParsing="false" onAction="#addTask" text="Add Engineering Task" />
                     </children>
                  </VBox>
               </children>
            </HBox>
             <HBox prefHeight="30.0" prefWidth="804.0" spacing="0">
                 <children>
                     <Button maxWidth="Infinity" onAction="#goToDashboard" prefHeight="26.0" prefWidth="243.0" text="Dashboard" HBox.hgrow="ALWAYS" />
      
                     <Button maxWidth="Infinity" onAction="#handleFinishSprint" prefHeight="26.0" prefWidth="242.0" text="Complete Sprint" HBox.hgrow="ALWAYS" />
                 </children>
             </HBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
